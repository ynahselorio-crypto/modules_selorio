      { id: 83, name: "Chicken Pops with Fries", price: 148, cost: 50, stock: 45, category: "Finger Foods" },
      { id: 84, name: "Special Fries",       price: 138, cost: 40, stock: 45, category: "Finger Foods" },
      { id: 85, name: "Crisscut",            price: 148, cost: 45, stock: 45, category: "Finger Foods" },
      { id: 86, name: "Potato Wedges",       price: 148, cost: 45, stock: 45, category: "Finger Foods" },
      { id: 87, name: "Cheesy Nachos",       price: 178, cost: 55, stock: 45, category: "Finger Foods" },
      { id: 88, name: "Clubhouse",           price: 148, cost: 50, stock: 45, category: "Finger Foods" },
      { id: 89, name: "Flavored Fries",      price: 108, cost: 30, stock: 45, category: "Finger Foods" },
      { id: 90, name: "Barkada Bundle 1",    price: 298, cost: 120, stock: 20, category: "Barkada Bundles" },
      { id: 91, name: "Barkada Bundle 2",    price: 298, cost: 120, stock: 20, category: "Barkada Bundles" }
    ];
    let nextId = 92;
    let currentCategory = "All";

    function linearSearchById(id) {
      for (let i = 0; i < menuItems.length; i++) {
        if (menuItems[i].id === id) return i;
      }
      return -1;
    }

    function searchItems(keyword) {
      const result = [];
      const key = keyword.toLowerCase();
      for (let i = 0; i < menuItems.length; i++) {
        const name = menuItems[i].name.toLowerCase();
        const category = menuItems[i].category.toLowerCase();
        if (name.indexOf(key) !== -1 || category.indexOf(key) !== -1) {
          result.push(menuItems[i]);
        }
      }
      return result;
    }

    function filterByCategory(category) {
      const result = [];
      for (let i = 0; i < menuItems.length; i++) {
        if (menuItems[i].category === category) result.push(menuItems[i]);
      }
      return result;
    }

    function getCategories() {
      const cats = ["All"];
      for (let i = 0; i < menuItems.length; i++) {
        let exists = false;
        for (let j = 0; j < cats.length; j++) {
          if (cats[j] === menuItems[i].category) { exists = true; break; }
        }
        if (!exists) cats.push(menuItems[i].category);
      }
      return cats;
    }

    function renderCategoryTabs() {
      const container = document.getElementById("categoryTabs");
      container.innerHTML = "";
      const categories = getCategories();
      for (let i = 0; i < categories.length; i++) {
        const cat = categories[i];
        const btn = document.createElement("button");
        btn.className = "cat-btn" + (cat === currentCategory ? " active" : "");
        btn.textContent = cat;
        btn.onclick = function () {
          currentCategory = cat;
          document.getElementById("searchInput").value = "";
          renderCategoryTabs();
          renderTable();
        };
        container.appendChild(btn);
      }
    }

    function renderTable() {
      const tbody = document.getElementById("tableBody");
      tbody.innerHTML = "";
      const keyword = document.getElementById("searchInput").value.trim();
      let displayItems = [];
      if (keyword !== "") {
        displayItems = searchItems(keyword);
      } else if (currentCategory === "All") {
        displayItems = menuItems;
      } else {
        displayItems = filterByCategory(currentCategory);
      }
      for (let i = 0; i < displayItems.length; i++) {
        const item = displayItems[i];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${item.id}</td>
          <td>${item.name}</td>
          <td>${item.category}</td>
          <td>₱${item.price}</td>
          <td>₱${item.cost}</td>
          <td>${item.stock}</td>
          <td class="actions">
            <button class="btn btn-secondary btn-sm" onclick="editItem(${item.id})">Edit</button>
            <button class="btn btn-danger btn-sm" onclick="deleteItem(${item.id})">Del</button>
          </td>
        `;
        tbody.appendChild(tr);
      }
      document.getElementById("itemCount").textContent = displayItems.length;
    }

    function showAddForm() {
      document.getElementById("formTitle").textContent = "Add Menu Item";
      document.getElementById("editId").value = "";
      document.getElementById("name").value = "";
      document.getElementById("category").value = "";
      document.getElementById("price").value = 0;
      document.getElementById("cost").value = 0;
      document.getElementById("stock").value = 0;
      document.getElementById("formSection").classList.remove("hidden");
    }

    function hideForm() {
      document.getElementById("formSection").classList.add("hidden");
    }

    function saveItem() {
      const id = document.getElementById("editId").value;
      const name = document.getElementById("name").value.trim();
      const category = document.getElementById("category").value.trim();
      const price = Number(document.getElementById("price").value);
      const cost = Number(document.getElementById("cost").value);
      const stock = Number(document.getElementById("stock").value);
      if (name === "" || category === "") {
        alert("Name and Category are required!");
        return;
      }
      if (id === "") {
        menuItems.push({ id: nextId, name, category, price, cost, stock });
        nextId++;
      } else {
        const index = linearSearchById(Number(id));
        if (index !== -1) {
          menuItems[index].name = name;
          menuItems[index].category = category;
          menuItems[index].price = price;
          menuItems[index].cost = cost;
          menuItems[index].stock = stock;
        }
      }
      hideForm();
      renderCategoryTabs();
      renderTable();
    }

    function editItem(id) {
      const index = linearSearchById(id);
      if (index === -1) return;
      const item = menuItems[index];
      document.getElementById("formTitle").textContent = "Edit Menu Item";
      document.getElementById("editId").value = item.id;
      document.getElementById("name").value = item.name;
      document.getElementById("category").value = item.category;
      document.getElementById("price").value = item.price;
      document.getElementById("cost").value = item.cost;
      document.getElementById("stock").value = item.stock;
      document.getElementById("formSection").classList.remove("hidden");
    }

    function deleteItem(id) {
      if (!confirm("Are you sure you want to delete this item?")) return;
      const index = linearSearchById(id);
      if (index === -1) return;
      for (let i = index; i < menuItems.length - 1; i++) {
        menuItems[i] = menuItems[i + 1];
      }
      menuItems.pop();
      renderCategoryTabs();
      renderTable();
    }

    document.getElementById("searchInput").addEventListener("input", renderTable);

    // =====================================================
    // PROMOTIONS & LOYALTY (your original logic)
    // =====================================================
    let promotions = [];
    let customers = [];

    function linearSearchPromo(code) {
      for (let i = 0; i < promotions.length; i++) {
        if (promotions[i].code === code) return i;
      }
      return -1;
    }

    function renderPromotions() {
      const tbody = document.getElementById("promoTableBody");
      tbody.innerHTML = "";
      for (let i = 0; i < promotions.length; i++) {
        const p = promotions[i];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${p.name}</td>
          <td>${p.code}</td>
          <td>${p.type}</td>
          <td>${p.type === "percent" ? p.value + "%" : p.value}</td>
          <td><span class="${p.status === "Active" ? "status-active" : "status-inactive"}">${p.status}</span></td>
          <td class="actions">
            <button class="btn btn-secondary btn-sm" onclick="toggleStatus('${p.code}')">${p.status === "Active" ? "Disable" : "Enable"}</button>
            <button class="btn btn-danger btn-sm" onclick="deletePromotion('${p.code}')">Del</button>
          </td>
        `;
        tbody.appendChild(tr);
      }
    }

    function renderLoyalty() {
      const tbody = document.getElementById("loyaltyTableBody");
      tbody.innerHTML = "";
      for (let i = 0; i < customers.length; i++) {
        const c = customers[i];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${c.name}</td>
          <td>${c.points}</td>
          <td>${c.visits}</td>
        `;
        tbody.appendChild(tr);
      }
    }

    function showAddFormPromo() {
      document.getElementById("formSectionPromo").classList.remove("hidden");
      document.getElementById("promoName").value = "";
      document.getElementById("promoCode").value = "";
      document.getElementById("promoType").value = "percent";
      document.getElementById("promoValue").value = 10;
    }

    function hideFormPromo() {
      document.getElementById("formSectionPromo").classList.add("hidden");
    }

    function addPromotion() {
      const name = document.getElementById("promoName").value.trim();
      const code = document.getElementById("promoCode").value.trim().toUpperCase();
      const type = document.getElementById("promoType").value;
      const value = Number(document.getElementById("promoValue").value);
      if (name === "" || code === "") {
        alert("Name and Code are required!");
        return;
      }
      if (linearSearchPromo(code) !== -1) {
        alert("Promotion code already exists!");
        return;
      }
      promotions.push({ name, code, type, value, status: "Active" });
      hideFormPromo();
      renderPromotions();
    }

    function toggleStatus(code) {
      const index = linearSearchPromo(code);
      if (index === -1) return;
      promotions[index].status = promotions[index].status === "Active" ? "Inactive" : "Active";
      renderPromotions();
    }

    function deletePromotion(code) {
      if (!confirm("Are you sure you want to delete this promotion?")) return;
      const index = linearSearchPromo(code);
      if (index === -1) return;
      for (let i = index; i < promotions.length - 1; i++) {
        promotions[i] = promotions[i + 1];
      }
      promotions.pop();
      renderPromotions();
    }

