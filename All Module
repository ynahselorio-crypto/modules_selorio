<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Café Templado – Management System</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: #0f0f0f;
      color: #e5e5e5;
      display: flex;
      min-height: 100vh;
    }

    /* ===== SIDEBAR ===== */
    .sidebar {
      width: 240px;
      background: #1a1a1a;
      border-right: 1px solid #2a2a2a;
      display: flex;
      flex-direction: column;
      padding: 20px 0;
      flex-shrink: 0;
    }

    .brand {
      padding: 0 24px 28px;
      border-bottom: 1px solid #2a2a2a;
      margin-bottom: 16px;
    }

    .brand h1 {
      font-size: 1.35rem;
      font-weight: 600;
      color: #d4a017;
    }

    .brand p {
      font-size: 0.8rem;
      color: #888;
      margin-top: 4px;
    }

    .nav { flex: 1; padding: 0 12px; }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: 8px;
      color: #b0b0b0;
      font-size: 0.92rem;
      margin-bottom: 2px;
      cursor: pointer;
      transition: all 0.15s;
      user-select: none;
    }

    .nav-item:hover { background: #252525; color: #e5e5e5; }
    .nav-item.active { background: #2a2a2a; color: #d4a017; font-weight: 500; }

    /* ===== MAIN ===== */
    .main {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #111;
      overflow: hidden;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 32px;
      border-bottom: 1px solid #2a2a2a;
      background: #161616;
      flex-shrink: 0;
    }

    .header h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #f0f0f0;
    }

    .header-right {
      font-size: 0.9rem;
      color: #aaa;
    }

    .content {
      padding: 28px 32px;
      overflow-y: auto;
      flex: 1;
    }

    /* ===== COMMON COMPONENTS ===== */
    .page-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .page-title-row h3 {
      font-size: 1rem;
      color: #999;
      font-weight: 500;
    }

    .btn {
      padding: 9px 16px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.15s;
    }

    .btn-primary { background: #d4a017; color: #1a1a1a; }
    .btn-primary:hover { background: #e0b020; }

    .btn-secondary {
      background: #2a2a2a;
      color: #e5e5e5;
      border: 1px solid #3a3a3a;
    }
    .btn-secondary:hover { background: #333; }

    .btn-danger { background: #dc2626; color: white; }
    .btn-danger:hover { background: #ef4444; }

    .btn-sm {
      padding: 5px 12px;
      font-size: 0.8rem;
      border-radius: 6px;
    }

    .card {
      background: #1c1c1c;
      border: 1px solid #2e2e2e;
      border-radius: 12px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }

    .card h3 {
      font-size: 1.1rem;
      font-weight: 600;
      color: #f0f0f0;
      margin-bottom: 18px;
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }

    thead th {
      text-align: left;
      padding: 12px 14px;
      color: #888;
      font-weight: 500;
      border-bottom: 1px solid #2e2e2e;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    tbody td {
      padding: 13px 14px;
      border-bottom: 1px solid #252525;
      color: #e0e0e0;
    }

    tbody tr:hover { background: #222; }

    .status-active {
      display: inline-block;
      background: #166534;
      color: #4ade80;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }

    .status-inactive {
      display: inline-block;
      background: #444;
      color: #aaa;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }

    .actions { display: flex; gap: 8px; }

    /* Forms */
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      color: #999;
      margin-bottom: 6px;
      font-weight: 500;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      background: #141414;
      border: 1px solid #333;
      border-radius: 8px;
      padding: 10px 14px;
      color: #e5e5e5;
      font-size: 0.95rem;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: #d4a017;
    }

    .form-row { display: flex; gap: 12px; margin-top: 8px; }

    .message {
      margin-top: 14px;
      font-size: 0.9rem;
      min-height: 20px;
    }
    .message.success { color: #4ade80; }
    .message.error { color: #f87171; }

    /* Search & tabs */
    .search-bar {
      width: 320px;
      background: #141414;
      border: 1px solid #333;
      border-radius: 8px;
      padding: 10px 14px;
      color: #e5e5e5;
      font-size: 0.9rem;
      margin-bottom: 16px;
    }
    .search-bar:focus { outline: none; border-color: #d4a017; }

    .category-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }

    .cat-btn {
      background: #2a2a2a;
      border: 1px solid #3a3a3a;
      color: #bbb;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.15s;
    }
    .cat-btn:hover { background: #333; color: #fff; }
    .cat-btn.active {
      background: #d4a017;
      color: #1a1a1a;
      border-color: #d4a017;
      font-weight: 500;
    }

    /* Modal / Form section */
    .form-section {
      background: #1c1c1c;
      border: 1px solid #2e2e2e;
      border-radius: 12px;
      padding: 24px 28px;
      margin-bottom: 24px;
      max-width: 480px;
    }

    .hidden { display: none; }

    /* Module visibility */
    .module { display: none; }
    .module.active { display: block; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="brand">
      <h1>Café Templado</h1>
      <p>System Admin (admin)</p>
    </div>

    <nav class="nav">
      <div class="nav-item" data-module="menu">Menu Management</div>
      <div class="nav-item" data-module="promo">Promotions & Loyalty</div>
      <div class="nav-item" data-module="settings">Settings</div>
    </nav>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <header class="header">
      <h2 id="pageTitle">Menu Management</h2>
      <div class="header-right">
        <span id="currentDate"></span>
      </div>
    </header>

    <div class="content">

      <!-- ==================== MENU MANAGEMENT ==================== -->
      <div id="module-menu" class="module active">
        <div class="page-title-row">
          <h3>Menu Items (<span id="itemCount">0</span>)</h3>
          <button class="btn btn-primary" onclick="showAddForm()">+ Add Item</button>
        </div>

        <input type="text" id="searchInput" class="search-bar" placeholder="Search by name or category...">

        <div id="categoryTabs" class="category-tabs"></div>

        <!-- Add / Edit Form -->
        <div id="formSection" class="form-section hidden">
          <h3 id="formTitle">Add Menu Item</h3>
          <input type="hidden" id="editId">

          <div class="form-group">
            <label>Name</label>
            <input type="text" id="name">
          </div>
          <div class="form-group">
            <label>Category</label>
            <input type="text" id="category">
          </div>
          <div class="form-group">
            <label>Price</label>
            <input type="number" id="price" value="0">
          </div>
          <div class="form-group">
            <label>Cost</label>
            <input type="number" id="cost" value="0">
          </div>
          <div class="form-group">
            <label>Stock</label>
            <input type="number" id="stock" value="0">
          </div>

          <div class="form-row">
            <button class="btn btn-primary" onclick="saveItem()">Save</button>
            <button class="btn btn-secondary" onclick="hideForm()">Cancel</button>
          </div>
        </div>

        <div class="card" style="padding: 0; overflow: hidden;">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Cost</th>
                <th>Stock</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- ==================== PROMOTIONS & LOYALTY ==================== -->
      <div id="module-promo" class="module">
        <div class="page-title-row">
          <h3>Promotions & Loyalty</h3>
          <button class="btn btn-primary" onclick="showAddFormPromo()">+ Add Promo</button>
        </div>

        <!-- Add Promo Form -->
        <div id="formSectionPromo" class="form-section hidden">
          <h3>Add Promotion</h3>
          <div class="form-group">
            <label>Name</label>
            <input type="text" id="promoName">
          </div>
          <div class="form-group">
            <label>Code</label>
            <input type="text" id="promoCode">
          </div>
          <div class="form-group">
            <label>Type</label>
            <select id="promoType">
              <option value="percent">Percent Off</option>
              <option value="free">Free Item</option>
            </select>
          </div>
          <div class="form-group">
            <label>Value</label>
            <input type="number" id="promoValue" value="10">
          </div>
          <div class="form-row">
            <button class="btn btn-primary" onclick="addPromotion()">Save</button>
            <button class="btn btn-secondary" onclick="hideFormPromo()">Cancel</button>
          </div>
        </div>

        <div class="card">
          <h3>Active Promotions</h3>
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Type</th>
                <th>Value</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="promoTableBody"></tbody>
          </table>
        </div>

        <div class="card">
          <h3>Loyalty Overview</h3>
          <p style="color:#999; font-size:0.9rem; margin-bottom:16px;">
            Customers earn <strong style="color:#e5e5e5;">1 point per ₱50</strong> spent. Points can be redeemed for free drinks.
          </p>
          <table>
            <thead>
              <tr>
                <th>Customer</th>
                <th>Points</th>
                <th>Visits</th>
              </tr>
            </thead>
            <tbody id="loyaltyTableBody"></tbody>
          </table>
        </div>
      </div>

      <!-- ==================== SETTINGS ==================== -->
      <div id="module-settings" class="module">
        <div class="card" style="max-width: 480px;">
          <h3>Store Settings</h3>

          <div class="form-group">
            <label>Store Name</label>
            <input type="text" id="storeName">
          </div>
          <div class="form-group">
            <label>Address</label>
            <input type="text" id="address">
          </div>
          <div class="form-group">
            <label>Phone Number</label>
            <input type="text" id="phone">
          </div>
          <div class="form-group">
            <label>Tax Rate (%)</label>
            <input type="number" id="taxRate" step="0.01">
          </div>
          <div class="form-group">
            <label>Service Charge (%)</label>
            <input type="number" id="serviceCharge" step="0.01">
          </div>
          <div class="form-group">
            <label>Currency Symbol</label>
            <input type="text" id="currency" size="5">
          </div>
          <div class="form-group">
            <label>Receipt Footer</label>
            <input type="text" id="receiptFooter">
          </div>

          <div class="form-row" style="margin-bottom: 24px;">
            <button class="btn btn-primary" onclick="saveSettings()">Save Settings</button>
          </div>

          <hr style="border:none; border-top:1px solid #2e2e2e; margin: 20px 0;">

          <h3 style="margin-bottom:14px;">Data</h3>
          <div class="form-row">
            <button class="btn btn-danger" onclick="resetAllData()">Reset All Data</button>
          </div>

          <p id="message" class="message"></p>
        </div>
      </div>

    </div>
  </main>

