      storeName: "Café Templado",
      address: "123 Ritual Street, Manila",
      phone: "+63 912 345 6789",
      taxRate: 12,
      serviceCharge: 0,
      currency: "₱",
      receiptFooter: "Thank you for elevating with us."
    };

    let settings = {
      storeName: "Café Templado",
      address: "123 Ritual Street, Manila",
      phone: "+63 912 345 6789",
      taxRate: 12,
      serviceCharge: 0,
      currency: "₱",
      receiptFooter: "Thank you for elevating with us."
    };

    function loadSettings() {
      document.getElementById("storeName").value = settings.storeName;
      document.getElementById("address").value = settings.address;
      document.getElementById("phone").value = settings.phone;
      document.getElementById("taxRate").value = settings.taxRate;
      document.getElementById("serviceCharge").value = settings.serviceCharge;
      document.getElementById("currency").value = settings.currency;
      document.getElementById("receiptFooter").value = settings.receiptFooter;
    }

    function saveSettings() {
      settings.storeName = document.getElementById("storeName").value.trim();
      settings.address = document.getElementById("address").value.trim();
      settings.phone = document.getElementById("phone").value.trim();
      settings.taxRate = Number(document.getElementById("taxRate").value);
      settings.serviceCharge = Number(document.getElementById("serviceCharge").value);
      settings.currency = document.getElementById("currency").value.trim();
      settings.receiptFooter = document.getElementById("receiptFooter").value.trim();

      if (settings.storeName === "" || settings.address === "" || settings.phone === "") {
        showMessage("Please fill in Store Name, Address, and Phone Number.", "error");
        return;
      }
      showMessage("Settings saved successfully!", "success");
    }

    function resetAllData() {
      if (!confirm("Are you sure you want to reset all settings to default?")) return;
      settings.storeName = defaultSettings.storeName;
      settings.address = defaultSettings.address;
      settings.phone = defaultSettings.phone;
      settings.taxRate = defaultSettings.taxRate;
      settings.serviceCharge = defaultSettings.serviceCharge;
      settings.currency = defaultSettings.currency;
      settings.receiptFooter = defaultSettings.receiptFooter;
      loadSettings();
      showMessage("All settings have been reset to default.", "success");
    }

    function showMessage(text, type) {
      const el = document.getElementById("message");
      el.textContent = text;
      el.className = "message " + type;
      setTimeout(() => {
        el.textContent = "";
        el.className = "message";
      }, 4000);
    }

    // =====================================================
    // INIT
    // =====================================================
    renderCategoryTabs();
    renderTable();
    renderPromotions();
    renderLoyalty();
    loadSettings();
  </script>
