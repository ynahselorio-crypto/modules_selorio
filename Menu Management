    let nextId = 92;
    let currentCategory = "All";

    // ========== MANUAL LINEAR SEARCH BY ID ==========
    function linearSearchById(id) {
      for (let i = 0; i < menuItems.length; i++) {
        if (menuItems[i].id === id) {
          return i;
        }
      }
      return -1;
    }

    // ========== MANUAL SEARCH ==========
    function searchItems(keyword) {
      const result = [];
      const key = keyword.toLowerCase();

      for (let i = 0; i < menuItems.length; i++) {
        const name = menuItems[i].name.toLowerCase();
        const category = menuItems[i].category.toLowerCase();

        if (name.indexOf(key) !== -1 || category.indexOf(key) !== -1) {
          result.push(menuItems[i]);
        }
      }
      return result;
    }

    // ========== MANUAL FILTER BY CATEGORY ==========
    function filterByCategory(category) {
      const result = [];
      for (let i = 0; i < menuItems.length; i++) {
        if (menuItems[i].category === category) {
          result.push(menuItems[i]);
        }
      }
      return result;
    }

    // ========== GET ALL UNIQUE CATEGORIES ==========
    function getCategories() {
      const cats = ["All"];
      for (let i = 0; i < menuItems.length; i++) {
        let exists = false;
        for (let j = 0; j < cats.length; j++) {
          if (cats[j] === menuItems[i].category) {
            exists = true;
            break;
          }
        }
        if (!exists) {
          cats.push(menuItems[i].category);
        }
      }
      return cats;
    }

    // ========== RENDER CATEGORY TABS ==========
    function renderCategoryTabs() {
      const container = document.getElementById("categoryTabs");
      container.innerHTML = "";

      const categories = getCategories();
      for (let i = 0; i < categories.length; i++) {
        const cat = categories[i];
        const btn = document.createElement("button");
        btn.textContent = (cat === currentCategory ? "→ " : "") + cat;
        btn.style.marginRight = "6px";
        btn.style.marginBottom = "6px";

        btn.onclick = function () {
          currentCategory = cat;
          document.getElementById("searchInput").value = "";
          renderCategoryTabs();
          renderTable();
        };
        container.appendChild(btn);
      }
    }

    // ========== RENDER TABLE ==========
    function renderTable() {
      const tbody = document.getElementById("tableBody");
      tbody.innerHTML = "";

      const keyword = document.getElementById("searchInput").value.trim();
      let displayItems = [];

      if (keyword !== "") {
        displayItems = searchItems(keyword);
      } else if (currentCategory === "All") {
        displayItems = menuItems;
      } else {
        displayItems = filterByCategory(currentCategory);
      }

      for (let i = 0; i < displayItems.length; i++) {
        const item = displayItems[i];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${item.id}</td>
          <td>${item.name}</td>
          <td>${item.category}</td>
          <td>₱${item.price}</td>
          <td>₱${item.cost}</td>
          <td>${item.stock}</td>
          <td>
            <button onclick="editItem(${item.id})">Edit</button>
            <button onclick="deleteItem(${item.id})">Del</button>
          </td>
        `;
        tbody.appendChild(tr);
      }

      document.getElementById("itemCount").textContent = displayItems.length;
    }

    // ========== FORM FUNCTIONS ==========
    function showAddForm() {
      document.getElementById("formTitle").textContent = "Add Menu Item";
      document.getElementById("editId").value = "";
      document.getElementById("name").value = "";
      document.getElementById("category").value = "";
      document.getElementById("price").value = 0;
      document.getElementById("cost").value = 0;
      document.getElementById("stock").value = 0;
      document.getElementById("formSection").style.display = "block";
    }

    function hideForm() {
      document.getElementById("formSection").style.display = "none";
    }

    function saveItem() {
      const id = document.getElementById("editId").value;
      const name = document.getElementById("name").value.trim();
      const category = document.getElementById("category").value.trim();
      const price = Number(document.getElementById("price").value);
      const cost = Number(document.getElementById("cost").value);
      const stock = Number(document.getElementById("stock").value);

      if (name === "" || category === "") {
        alert("Name and Category are required!");
        return;
      }

      if (id === "") {
        // ADD
        const newItem = {
          id: nextId,
          name: name,
          category: category,
          price: price,
          cost: cost,
          stock: stock
        };
        menuItems.push(newItem);
        nextId++;
      } else {
        // EDIT
        const index = linearSearchById(Number(id));
        if (index !== -1) {
          menuItems[index].name = name;
          menuItems[index].category = category;
          menuItems[index].price = price;
          menuItems[index].cost = cost;
          menuItems[index].stock = stock;
        }
      }

      hideForm();
      renderCategoryTabs();
      renderTable();
    }

    function editItem(id) {
      const index = linearSearchById(id);
      if (index === -1) return;

      const item = menuItems[index];
      document.getElementById("formTitle").textContent = "Edit Menu Item";
      document.getElementById("editId").value = item.id;
      document.getElementById("name").value = item.name;
      document.getElementById("category").value = item.category;
      document.getElementById("price").value = item.price;
      document.getElementById("cost").value = item.cost;
      document.getElementById("stock").value = item.stock;
      document.getElementById("formSection").style.display = "block";
    }

    // ========== MANUAL DELETE ==========
    function deleteItem(id) {
      if (!confirm("Are you sure you want to delete this item?")) return;

      const index = linearSearchById(id);
      if (index === -1) return;

      // Manual shift
      for (let i = index; i < menuItems.length - 1; i++) {
        menuItems[i] = menuItems[i + 1];
      }
      menuItems.pop();

      renderCategoryTabs();
      renderTable();
    }

    // ========== EVENT ==========
    document.getElementById("searchInput").addEventListener("input", renderTable);

    // ========== INIT ==========
    renderCategoryTabs();
    renderTable();
  </script>
