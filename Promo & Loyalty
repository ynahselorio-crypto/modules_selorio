<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Promotions and Loyalty Module</title>
</head>
<body>

  <h1>Promotions & Loyalty Module</h1>
<hr>
  <!-- ACTIVE PROMOTIONS TABLE -->
  <h2>Active Promotions</h2>
  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>Name</th>
        <th>Code</th>
        <th>Type</th>
        <th>Value</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="promoTableBody"></tbody>
  </table>

  <br>

  <button onclick="showAddForm()">+ Add Promo</button>
  <br><br>

  <!-- ADD PROMOTION FORM (now below the table) -->
  <div id="formSection" style="display:none;">
    <h3>Add Promotion</h3>

    Name:<br>
    <input type="text" id="promoName" size="30"><br><br>

    Code:<br>
    <input type="text" id="promoCode" size="20"><br><br>

    Type:<br>
    <select id="promoType">
      <option value="percent">Percent Off</option>
      <option value="free">Free Item</option>
    </select><br><br>

    Value:<br>
    <input type="number" id="promoValue" value="10"><br><br>

    <button onclick="addPromotion()">Save</button>
    <button onclick="hideForm()">Cancel</button>
    <br><br>
  </div>
<hr>
  <!-- LOYALTY OVERVIEW -->
  <h2>Loyalty Overview</h2>
  <p>Customers earn <strong>1 point per ₱50</strong> spent. Points can be redeemed for free drinks.</p>

  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>Customer</th>
        <th>Points</th>
        <th>Visits</th>
      </tr>
    </thead>
    <tbody id="loyaltyTableBody"></tbody>
  </table>

  <script>
    let promotions = [
      { name: "Happy Hour 20%", code: "HAPPY20", type: "percent", value: 20, status: "Active" },
      { name: "Loyalty Free Drink", code: "LOYALFREE", type: "free", value: 1, status: "Active" }
    ];

    let customers = [
      { name: "Anna Reyes", points: 120, visits: 8 },
      { name: "Carlo Mendoza", points: 45, visits: 3 }
    ];

    function linearSearchPromo(code) {
      for (let i = 0; i < promotions.length; i++) {
        if (promotions[i].code === code) {
          return i;
        }
      }
      return -1;
    }

    function renderPromotions() {
      const tbody = document.getElementById("promoTableBody");
      tbody.innerHTML = "";

      for (let i = 0; i < promotions.length; i++) {
        const p = promotions[i];
        const tr = document.createElement("tr");

        tr.innerHTML = `
          <td>${p.name}</td>
          <td>${p.code}</td>
          <td>${p.type}</td>
          <td>${p.type === "percent" ? p.value + "%" : p.value}</td>
          <td>${p.status}</td>
          <td>
            <button onclick="toggleStatus('${p.code}')">${p.status === "Active" ? "Disable" : "Enable"}</button>
            <button onclick="deletePromotion('${p.code}')">Del</button>
          </td>
        `;
        tbody.appendChild(tr);
      }
    }

    function renderLoyalty() {
      const tbody = document.getElementById("loyaltyTableBody");
      tbody.innerHTML = "";

      for (let i = 0; i < customers.length; i++) {
        const c = customers[i];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${c.name}</td>
          <td>${c.points}</td>
          <td>${c.visits}</td>
        `;
        tbody.appendChild(tr);
      }
    }

    function showAddForm() {
      document.getElementById("formSection").style.display = "block";
      document.getElementById("promoName").value = "";
      document.getElementById("promoCode").value = "";
      document.getElementById("promoType").value = "percent";
      document.getElementById("promoValue").value = 10;
    }

    function hideForm() {
      document.getElementById("formSection").style.display = "none";
    }

    function addPromotion() {
      const name = document.getElementById("promoName").value.trim();
      const code = document.getElementById("promoCode").value.trim().toUpperCase();
      const type = document.getElementById("promoType").value;
      const value = Number(document.getElementById("promoValue").value);

      if (name === "" || code === "") {
        alert("Name and Code are required!");
        return;
      }

      if (linearSearchPromo(code) !== -1) {
        alert("Promotion code already exists!");
        return;
      }

      promotions.push({
        name: name,
        code: code,
        type: type,
        value: value,
        status: "Active"
      });

      hideForm();
      renderPromotions();
    }

    function toggleStatus(code) {
      const index = linearSearchPromo(code);
      if (index === -1) return;

      if (promotions[index].status === "Active") {
        promotions[index].status = "Inactive";
      } else {
        promotions[index].status = "Active";
      }
      renderPromotions();
    }

    function deletePromotion(code) {
      if (!confirm("Are you sure you want to delete this promotion?")) return;

      const index = linearSearchPromo(code);
      if (index === -1) return;

      for (let i = index; i < promotions.length - 1; i++) {
        promotions[i] = promotions[i + 1];
      }
      promotions.pop();

      renderPromotions();
    }

    renderPromotions();
    renderLoyalty();
  </script>
</body>
</html>
