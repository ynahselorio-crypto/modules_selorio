let promotions = [];
let customers = [];

function linearSearchPromo(code) {
  for (let i = 0; i < promotions.length; i++) {
    if (promotions[i].code === code) return i;
  }
  return -1;
}

function renderPromotions() {
  const tbody = document.getElementById("promoTableBody");
  tbody.innerHTML = "";
  for (let i = 0; i < promotions.length; i++) {
    const p = promotions[i];
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${p.code}</td>
      <td>${p.type}</td>
      <td>${p.type === "percent" ? p.value + "%" : p.value}</td>
      <td><span class="${p.status === "Active" ? "status-active" : "status-inactive"}">${p.status}</span></td>
      <td class="actions">
        <button class="btn btn-secondary btn-sm" onclick="toggleStatus('${p.code}')">${p.status === "Active" ? "Disable" : "Enable"}</button>
        <button class="btn btn-danger btn-sm" onclick="deletePromotion('${p.code}')">Del</button>
      </td>
    `;
    tbody.appendChild(tr);
  }
}

function renderLoyalty() {
  const tbody = document.getElementById("loyaltyTableBody");
  tbody.innerHTML = "";
  for (let i = 0; i < customers.length; i++) {
    const c = customers[i];
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${c.name}</td>
      <td>${c.points}</td>
    `;
    tbody.appendChild(tr);
  }
}

function showAddFormPromo() {
  document.getElementById("formSectionPromo").classList.remove("hidden");
  document.getElementById("promoName").value = "";
  document.getElementById("promoCode").value = "";
  document.getElementById("promoType").value = "percent";
  document.getElementById("promoValue").value = 10;
}

function hideFormPromo() {
  document.getElementById("formSectionPromo").classList.add("hidden");
}

function addPromotion() {
  const name = document.getElementById("promoName").value.trim();
  const code = document.getElementById("promoCode").value.trim().toUpperCase();
  const type = document.getElementById("promoType").value;
  const value = Number(document.getElementById("promoValue").value);

  if (name === "" || code === "") {
    alert("Name and Code are required!");
    return;
  }
  if (linearSearchPromo(code) !== -1) {
    alert("Promotion code already exists!");
    return;
  }

  promotions.push({ name, code, type, value, status: "Active" });
  hideFormPromo();
  renderPromotions();
}

function toggleStatus(code) {
  const index = linearSearchPromo(code);
  if (index === -1) return;
  promotions[index].status = promotions[index].status === "Active" ? "Inactive" : "Active";
  renderPromotions();
}

function deletePromotion(code) {
  if (!confirm("Are you sure you want to delete this promotion?")) return;
  const index = linearSearchPromo(code);
  if (index === -1) return;

  for (let i = index; i < promotions.length - 1; i++) {
    promotions[i] = promotions[i + 1];
  }
  promotions.pop();
  renderPromotions();
}


